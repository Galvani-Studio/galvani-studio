# Endpoint WordPress que salva no banco e notifica por e-mail.
# Em desenvolvimento: http://127.0.0.1:8085/?rest_route=/galvani/v1/requests
# Em produção, use HTTPS e um WordPress acessível ao servidor Next.js.
QUOTE_WEBHOOK_URL=https://seu-wordpress.com/wp-json/galvani/v1/requests
# Mesmo segredo de GALVANI_API_TOKEN no WordPress. Apenas no servidor.
QUOTE_WEBHOOK_TOKEN=

# URL pública usada no OpenGraph, nas canonical URLs e no JSON-LD.
NEXT_PUBLIC_SITE_URL=https://galvanistudio.com
